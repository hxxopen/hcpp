{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hxxopen.github.io/hcpp/schema/provenance-record.schema.json",
  "title": "HCPP Provenance Record",
  "description": "HCPP v0.1 Provenance Record schema. Experimental.",
  "type": "object",
  "required": [
    "hcpp",
    "id",
    "type",
    "publisher",
    "content",
    "revision",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "hcpp": {
      "type": "string",
      "description": "HCPP protocol version",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "description": "HCPP Object Identifier (HXX-{TYPE}-{UUIDv7})",
      "pattern": "^HXX-[A-Z]{2,8}-[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
    },
    "type": {
      "type": "string",
      "description": "Artifact type",
      "enum": [
        "article",
        "report",
        "document",
        "pdf",
        "image",
        "video",
        "audio",
        "dataset",
        "webpage",
        "source",
        "other"
      ]
    },
    "publisher": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Publisher identifier",
          "minLength": 1
        }
      }
    },
    "content": {
      "$ref": "#/$defs/contentDescriptor"
    },
    "metadata": {
      "type": "object",
      "description": "Human-readable and descriptive metadata",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "revision": {
      "type": "object",
      "required": ["number"],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "type": ["string", "null"],
          "description": "Previous revision ID, or null for the first revision"
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "status": {
      "type": "string",
      "enum": ["active", "superseded", "revoked", "withdrawn"],
      "default": "active"
    }
  },
  "$defs": {
    "contentDescriptor": {
      "type": "object",
      "required": ["mediaType", "hash"],
      "additionalProperties": false,
      "properties": {
        "mediaType": {
          "type": "string",
          "description": "IANA media type"
        },
        "encoding": {
          "type": "string",
          "description": "Character encoding, typically utf-8 for text"
        },
        "canonicalization": {
          "type": "string",
          "description": "Canonicalization method applied before hashing",
          "enum": [
            "bom-strip+lf-normalize",
            "none",
            "jcs",
            "rfc8785"
          ]
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "hash": {
      "type": "object",
      "required": ["algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["SHA-256"]
        },
        "value": {
          "type": "string",
          "description": "Hex-encoded hash value (lowercase recommended)",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["Ed25519"]
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "description": "Base64url-encoded signature"
        }
      }
    }
  }
}
